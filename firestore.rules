rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default: allow read and write for all application collections
    // This supports both custom BUMD authentication (superman / credentials) and Google Auth
    match /users/{userId} {
      allow read, write: if true;
    }

    match /units/{unitId} {
      allow read, write: if true;
    }

    match /risk_registers/{riskId} {
      allow read, write: if true;
    }

    match /pkpt/{pkptId} {
      allow read, write: if true;
    }

    match /rka_items/{rkaId} {
      allow read, write: if true;
    }

    match /rka_sub_items/{subId} {
      allow read, write: if true;
    }

    match /rka_categories/{catId} {
      allow read, write: if true;
    }

    match /rka_group_categories/{groupId} {
      allow read, write: if true;
    }

    match /spi_programs/{programId} {
      allow read, write: if true;
    }

    match /audit_assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /audit_programs/{programId} {
      allow read, write: if true;
    }

    match /work_papers/{kkaId} {
      allow read, write: if true;
    }

    match /findings/{findingId} {
      allow read, write: if true;
    }

    match /recommendations/{recId} {
      allow read, write: if true;
    }

    match /follow_ups/{followUpId} {
      allow read, write: if true;
    }

    match /investigations/{caseId} {
      allow read, write: if true;
    }

    match /regulations/{regId} {
      allow read, write: if true;
    }

    match /signatories/{signatoryId} {
      allow read, write: if true;
    }

    match /audit_reports/{reportId} {
      allow read, write: if true;
    }

    match /bpkp_assessments/{assessmentId} {
      allow read, write: if true;
    }

    match /risk_profiles/{profileId} {
      allow read, write: if true;
    }

    match /risk_annual_reports/{reportId} {
      allow read, write: if true;
    }

    match /spi_periodic_reports/{reportId} {
      allow read, write: if true;
    }

    match /audit_universe/{entityId} {
      allow read, write: if true;
    }

    match /wbs_reports/{reportId} {
      allow read, write: if true;
    }

    match /wbs_assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /wbs_work_papers/{kkaId} {
      allow read, write: if true;
    }

    match /wbs_results/{resultId} {
      allow read, write: if true;
    }

    match /wbs_evidence_chunks/{chunkId} {
      allow read, write: if true;
    }

    match /kpi_items/{kpiId} {
      allow read, write: if true;
    }

    match /kpi_measurements/{measurementId} {
      allow read, write: if true;
    }

    match /kpi_checklist/{itemId} {
      allow read, write: if true;
    }

    match /kpi_settings/{settingId} {
      allow read, write: if true;
    }

    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    match /fin_accounts/{accountId} {
      allow read, write: if true;
    }

    match /fin_cash_banks/{cashBankId} {
      allow read, write: if true;
    }

    match /fin_transactions/{txId} {
      allow read, write: if true;
    }

    match /fin_bank_reconciliations/{recId} {
      allow read, write: if true;
    }

    match /fin_journals/{journalId} {
      allow read, write: if true;
    }

    match /fin_period_closes/{closeId} {
      allow read, write: if true;
    }

    match /fin_receivables_payables/{rpId} {
      allow read, write: if true;
    }

    match /fin_assets/{assetId} {
      allow read, write: if true;
    }

    match /fin_taxes/{taxId} {
      allow read, write: if true;
    }

    match /fin_inventory/{itemId} {
      allow read, write: if true;
    }

    match /fin_purchases/{purchaseId} {
      allow read, write: if true;
    }

    match /fin_pdam_reports/{reportId} {
      allow read, write: if true;
    }

    match /fin_audit_trails/{trailId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
